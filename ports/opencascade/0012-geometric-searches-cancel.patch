   Standard_EXPORT static Message_ProgressRange Start(
     const occ::handle<Message_ProgressIndicator>& theProgress);
 
+  //!@name RayCAD (patch 0012): a user break for long geometric searches that take no progress range
+  //! The range whose user break the calling thread's long geometric searches poll (the start points of a
+  //! curve/surface intersection, a surface/surface walk), or null. Set by the jobs of a boolean that own a range.
+  Standard_EXPORT static const Message_ProgressRange* ThreadRange();
+  //! Sets the calling thread's range (null: none) and returns the previous one, to be restored.
+  Standard_EXPORT static const Message_ProgressRange* SetThreadRange(const Message_ProgressRange* theRange);
+  //! True if the calling thread has a range and its indicator signals a user break.
+  Standard_EXPORT static bool ThreadUserBreak();
+
+  //! Sets the calling thread's range for its lifetime and restores the previous one after.
+  class ThreadRangeScope
+  {
+  public:
+    explicit ThreadRangeScope(const Message_ProgressRange& theRange)
+        : myPrevious(SetThreadRange(&theRange))
+    {
+    }
+    ~ThreadRangeScope() { SetThreadRange(myPrevious); }
+    ThreadRangeScope(const ThreadRangeScope&)            = delete;
+    ThreadRangeScope& operator=(const ThreadRangeScope&) = delete;
+
+  private:
+    const Message_ProgressRange* myPrevious;
+  };
+
 protected:
   //!@name Virtual methods to be defined by descendant.
 
