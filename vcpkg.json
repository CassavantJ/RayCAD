{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "raycad",
  "version-string": "0.1.0",
  "description": "Open-source desktop CAD/CAM",
  "license": "LGPL-2.1-or-later",
  "dependencies": [
    "blake3",
    "boost-graph",
    "boost-math",
    "catch2",
    "eigen3",
    {
      "name": "opencascade",
      "default-features": false
    },
    {
      "name": "tbb",
      "default-features": false
    },
    {
      "name": "sqlite3",
      "default-features": false
    },
    "tl-expected",
    "zstd"
  ],
  "overrides": [
    {
      "name": "opencascade",
      "version": "8.0.1",
      "port-version": 1
    }
  ]
}
